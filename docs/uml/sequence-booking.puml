@startuml
actor Viaggiatore
boundary CheckoutGraphicController as GUI
control AppContext as CTX
control ManageBookingsApplicationController as AC
control BookingFacade as FACADE
participant UserSession as SESSION
participant HotelDAO as HDAO
participant BookingPriceDecoratorFactory as DECORATOR
participant BookingDAO as BDAO
participant UserDAO as UDAO
control FlowContext as FLOW
control SceneRouter as ROUTER

== Apertura checkout e preventivo ==
GUI -> FLOW : getSelectedHotel()\ngetLastCriteria()
FLOW --> GUI : HotelBean + SearchCriteriaBean
GUI -> AC : getQuote(BookingRequestBean)
AC -> FACADE : quote(request)
FACADE -> FACADE : request.validateSyntax()
FACADE -> SESSION : isTraveler() / requireUser()
SESSION --> FACADE : UserBean
FACADE -> HDAO : findById(hotelId)
HDAO --> FACADE : HotelRoom
FACADE -> DECORATOR : decorate(basePrice, extras)
DECORATOR --> FACADE : BookingPriceComponent
FACADE --> AC : BookingQuoteBean
AC --> GUI : BookingQuoteBean
GUI -> GUI : aggiorna prezzi nelle Label

== Conferma ==
Viaggiatore -> GUI : preme Conferma
GUI -> GUI : validCardFields()\nbuildRequest()
GUI -> CTX : manageBookingsController()
CTX --> GUI : ManageBookingsApplicationController
GUI -> AC : confirm(request)
AC -> FACADE : createBooking(request)

FACADE -> FACADE : quote(request)\nricalcolo e validazione
FACADE -> SESSION : requireUser()
SESSION --> FACADE : UserBean
FACADE -> BDAO : isHotelAvailable(hotelId, date)
BDAO --> FACADE : true
FACADE -> FACADE : new Booking(...)
FACADE -> BDAO : save(booking)
BDAO --> FACADE : Booking con id
FACADE -> UDAO : updatePoints(userId, nuoviPunti)
UDAO --> FACADE : aggiornamento completato
FACADE -> SESSION : updatePoints(nuoviPunti)
FACADE --> AC : BookingBean
AC -> FLOW : clearBookingFlow()
AC --> GUI : BookingBean
GUI -> GUI : mostra codice prenotazione
GUI -> ROUTER : show(PROFILE)
@enduml
