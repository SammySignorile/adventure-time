@startuml
skinparam packageStyle rectangle
actor Viaggiatore
boundary SearchHotelView
boundary HotelListView
boundary CheckoutView
control SearchHotelApplicationController
control BookingApplicationController
control BookingFacade
entity HotelRoom
entity Booking
entity User

Viaggiatore --> SearchHotelView
SearchHotelView --> SearchHotelApplicationController : SearchCriteriaBean
SearchHotelApplicationController --> HotelRoom : pull via HotelDAO
SearchHotelApplicationController --> Booking : availability via BookingDAO
SearchHotelApplicationController --> HotelListView : List<HotelBean>
HotelListView --> CheckoutView : selected HotelBean
CheckoutView --> BookingApplicationController : BookingRequestBean
BookingApplicationController --> BookingFacade
BookingFacade --> HotelRoom
BookingFacade --> Booking
BookingFacade --> User
@enduml
