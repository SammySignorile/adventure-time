@startuml
skinparam packageStyle rectangle
actor Viaggiatore
boundary SearchHotelView
boundary HotelListView
boundary CheckoutView
control ManageBookingsApplicationController
control BookingFacade
entity HotelRoom
entity Booking
entity User

Viaggiatore --> SearchHotelView
SearchHotelView --> ManageBookingsApplicationController : SearchCriteriaBean
ManageBookingsApplicationController --> HotelRoom : pull via HotelDAO
ManageBookingsApplicationController --> Booking : availability via BookingDAO
ManageBookingsApplicationController --> HotelListView : List<HotelBean>
HotelListView --> CheckoutView : selected HotelBean
CheckoutView --> ManageBookingsApplicationController : BookingRequestBean
ManageBookingsApplicationController --> BookingFacade
BookingFacade --> HotelRoom
BookingFacade --> Booking
BookingFacade --> User
@enduml
