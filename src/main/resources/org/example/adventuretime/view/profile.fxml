<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.adventuretime.ui.gui.controller.ProfileGraphicController"
            styleClass="page-background">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
            <padding><Insets top="16" right="22" bottom="16" left="22"/></padding>
            <Button text="← Home" onAction="#onBack" styleClass="ghost-button"/>
            <Label text="Profilo" styleClass="brand-small"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="20">
            <padding><Insets top="25" right="30" bottom="30" left="30"/></padding>
            <GridPane hgap="25" vgap="10" styleClass="surface-card">
                <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
                <Label text="Nome" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted-label"/>
                <Label fx:id="nameLabel" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="subsection-title"/>
                <Label text="Email" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="muted-label"/>
                <Label fx:id="emailLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Ruolo" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="muted-label"/>
                <Label fx:id="roleLabel" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <Label text="Punti" GridPane.rowIndex="0" GridPane.columnIndex="3" styleClass="muted-label"/>
                <Label fx:id="pointsLabel" GridPane.rowIndex="1" GridPane.columnIndex="3" styleClass="points-label"/>
            </GridPane>
            <Label text="Prenotazioni" styleClass="section-title"/>
            <TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="hotelColumn" text="Hotel" prefWidth="170"/>
                    <TableColumn fx:id="datesColumn" text="Date" prefWidth="190"/>
                    <TableColumn fx:id="peopleColumn" text="Persone" prefWidth="75"/>
                    <TableColumn fx:id="totalColumn" text="Totale" prefWidth="90"/>
                    <TableColumn fx:id="extrasColumn" text="Extra" prefWidth="250"/>
                    <TableColumn fx:id="statusColumn" text="Stato" prefWidth="190"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
