<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.adventuretime.ui.gui.controller.TravelerHomeGraphicController"
            styleClass="page-background">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
            <padding><Insets top="18" right="25" bottom="18" left="25"/></padding>
            <Label text="Adventure Time" styleClass="brand-small"/>
            <Label fx:id="welcomeLabel" styleClass="top-welcome"/>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="22">
            <Label text="Cosa vuoi fare oggi?" styleClass="section-title"/>
            <Button text="Cerca e prenota un hotel" onAction="#onSearchHotelClick"
                    prefWidth="310" prefHeight="52" styleClass="primary-button"/>
            <Button text="Profilo e prenotazioni" onAction="#onProfileClick"
                    prefWidth="310" prefHeight="52" styleClass="secondary-button"/>
            <Button text="Logout" onAction="#onLogoutClick"
                    prefWidth="310" styleClass="danger-button"/>
        </VBox>
    </center>
</BorderPane>
