<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.adventuretime.ui.gui.controller.SearchHotelGraphicController"
            styleClass="page-background">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
            <padding><Insets top="16" right="22" bottom="16" left="22"/></padding>
            <Button text="← Indietro" onAction="#onBack" styleClass="ghost-button"/>
            <Label text="Cerca hotel" styleClass="brand-small"/>
        </HBox>
    </top>
    <center>
        <VBox alignment="TOP_CENTER" spacing="24">
            <padding><Insets top="38" right="30" bottom="30" left="30"/></padding>
            <Label text="Dove vuoi andare?" styleClass="section-title"/>
            <GridPane hgap="16" vgap="18" maxWidth="620" styleClass="surface-card">
                <padding><Insets top="28" right="30" bottom="28" left="30"/></padding>
                <Label text="Città" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="cityField" promptText="Roma" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="340"/>
                <Label text="Check-in" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="checkInField" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="340"/>
                <Label text="Check-out" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <DatePicker fx:id="checkOutField" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="340"/>
                <Label text="Persone" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="peopleField" promptText="2" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Prezzo massimo/notte" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="priceField" promptText="200" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Button text="Cerca disponibilità" onAction="#onSearchClick"
                        GridPane.rowIndex="5" GridPane.columnIndex="1"
                        prefWidth="340" styleClass="primary-button"/>
            </GridPane>
        </VBox>
    </center>
</BorderPane>
