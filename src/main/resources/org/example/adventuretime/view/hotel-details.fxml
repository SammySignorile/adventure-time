<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.adventuretime.ui.gui.controller.HotelDetailsGraphicController"
            styleClass="page-background">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
            <padding>
                <Insets top="16" right="22" bottom="16" left="22"/>
            </padding>
            <Button text="← Torna agli hotel"
                    onAction="#onBack"
                    styleClass="ghost-button"/>
            <Label text="Dettagli hotel" styleClass="brand-small"/>
        </HBox>
    </top>

    <center>
        <HBox alignment="TOP_CENTER" spacing="28">
            <padding>
                <Insets top="28" right="38" bottom="30" left="38"/>
            </padding>

            <VBox spacing="10" prefWidth="590">
                <StackPane prefWidth="590" prefHeight="370"
                           styleClass="details-image-box">
                    <ImageView fx:id="hotelImageView"
                               fitWidth="590" fitHeight="370"
                               preserveRatio="true"
                               smooth="true"/>

                    <Label fx:id="missingImageLabel"
                           text="Foto non disponibile"
                           wrapText="true"
                           styleClass="missing-image-label"/>

                    <Button fx:id="previousButton"
                            text="‹"
                            onAction="#onPreviousImage"
                            StackPane.alignment="CENTER_LEFT"
                            styleClass="carousel-button">
                        <StackPane.margin>
                            <Insets left="12"/>
                        </StackPane.margin>
                    </Button>

                    <Button fx:id="nextButton"
                            text="›"
                            onAction="#onNextImage"
                            StackPane.alignment="CENTER_RIGHT"
                            styleClass="carousel-button">
                        <StackPane.margin>
                            <Insets right="12"/>
                        </StackPane.margin>
                    </Button>

                    <Label fx:id="imageCounterLabel"
                           text="0 / 0"
                           StackPane.alignment="BOTTOM_CENTER"
                           styleClass="image-counter">
                        <StackPane.margin>
                            <Insets bottom="12"/>
                        </StackPane.margin>
                    </Label>
                </StackPane>
            </VBox>

            <VBox spacing="12" prefWidth="330" styleClass="surface-card">
                <padding>
                    <Insets top="24" right="24" bottom="24" left="24"/>
                </padding>

                <Label fx:id="nameLabel"
                       text="Nome hotel"
                       wrapText="true"
                       styleClass="section-title"/>
                <Label fx:id="cityLabel" text="Città" styleClass="muted-label"/>
                <Label fx:id="roomTypeLabel" text="Tipo camera"/>
                <Label fx:id="servicesLabel" text="Servizi" wrapText="true"/>
                <Label fx:id="distanceLabel" text="Distanza" styleClass="muted-label"/>
                <Label fx:id="capacityLabel" text="Capienza" styleClass="muted-label"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Label fx:id="priceLabel"
                       text="€0/notte"
                       styleClass="price-label"/>
                <Button text="Prenota questa camera"
                        onAction="#onBookClick"
                        styleClass="primary-button"
                        maxWidth="Infinity"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
